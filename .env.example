# ---------------------------------------------------------------------------
# All settings are optional -- every value below is the built-in default.
# Copy to `.env` and uncomment only what you want to change.
# ---------------------------------------------------------------------------

# --- paths -----------------------------------------------------------------
# RAG_DATA_DIR=./data
# RAG_QDRANT_PATH=./qdrant_db
# RAG_EMBEDDING_CACHE_DIR=./data/embedding_cache
# Where the API parks uploaded files before ingesting them.
# RAG_UPLOADS_DIR=./data/uploads

# --- server ----------------------------------------------------------------
# Loopback by default. The server has no authentication and can read and
# delete the index, so binding it to a public interface is an explicit
# decision (RAG_API_HOST=0.0.0.0), not a default.
# RAG_API_HOST=127.0.0.1
# RAG_API_PORT=8000
# Largest accepted upload. The browser checks this before sending, so it only
# ever fires for a caller that did not (curl, a script).
# RAG_MAX_UPLOAD_MB=512

# --- models ----------------------------------------------------------------
# bge-small-en-v1.5: 33M params, 384-dim, 512-token context, ~130MB, fast on
# CPU. Swap to BAAI/bge-m3 for multilingual / 8192-token contexts (~2.3GB).
# RAG_DENSE_MODEL=BAAI/bge-small-en-v1.5
# RAG_SPARSE_MODEL=Qdrant/bm25
# "auto" picks cuda > mps > cpu.
# RAG_DEVICE=auto

# --- reranking -------------------------------------------------------------
# Cross-encoder cost scales with RAG_FETCH_K. Default is 22M params (~90MB),
# ~10-30ms per pair on CPU.
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- chunking --------------------------------------------------------------
# Measured in dense-model tokens. Must not exceed RAG_MAX_MODEL_TOKENS.
# Defaults below fit bge-small's 512-token window.
#
# Every chunk opens with its section breadcrumb ("Chapter 3 > GRPO") as text,
# not metadata, so the heading is part of what gets embedded, BM25-matched and
# reranked. That is what lets a passage be found by the name of the section it
# is in even when the passage never repeats the name itself. Changing anything
# in this section changes chunk ids, so it needs a re-ingest with force.
# RAG_CHUNK_SIZE=384
# RAG_CHUNK_OVERLAP=48
# RAG_MIN_CHUNK_TOKENS=24
# RAG_MAX_MODEL_TOKENS=512

# --- parsing ---------------------------------------------------------------
# hi_res extracts tables; fast is ~5x quicker but finds none.
# RAG_PDF_STRATEGY=hi_res
# RAG_PDF_BATCH_SIZE=20
# RAG_DEDUPE_WINDOW=10
# Drop text repeating on more than this fraction of pages (running headers).
# RAG_FURNITURE_PAGE_RATIO=0.3
# Tesseract languages for OCR of scanned PDFs (RAG_PDF_STRATEGY=ocr_only).
# RAG_OCR_LANGUAGES=["eng"]

# --- retrieval -------------------------------------------------------------
# RAG_COLLECTION_NAME=documents
# Candidates pulled from Qdrant before reranking. Kept at 30 rather than 50
# because rerank cost is linear in this number and we are on CPU.
# RAG_FETCH_K=30
# Chunks returned after reranking -- and so the context budget the answer is
# written from. Widening (below) multiplies what each one costs.
# RAG_TOP_K=8
# RAG_RETRIEVAL_MODE=hybrid
# Drop reranked chunks scoring below this logit. 0.0 disables. ms-marco puts
# the relevant/irrelevant boundary at 0, so a small positive value trims
# passages the model would otherwise be invited to blend into its answer. The
# best passage always survives whatever this is set to.
# RAG_RERANK_SCORE_THRESHOLD=0.0
# How many chunks either side of each reranked passage to pull in as context.
# Widening runs after the rerank, not before, so a neighbour completes a
# passage the cross-encoder actually chose instead of competing with it.
# RAG_CONTEXT_NEIGHBOUR_RADIUS=1
# Ceiling on the rendered context, in dense-model tokens, after widening.
# Context is trimmed from the lowest-ranked passages inward; a passage is never
# dropped in favour of its own neighbours.
# RAG_CONTEXT_TOKEN_BUDGET=4000

# --- optional web search ----------------------------------------------------
# The fallback for a question the documents cannot answer. Nothing here runs
# unless a user clicks the button on such an answer -- there is no automatic
# egress -- and the corpus is always tried first.
# RAG_ENABLE_WEB_SEARCH=true
# "auto" uses Tavily when a key is set, otherwise the keyless backend (ddgs),
# otherwise the button is not offered at all.
# RAG_WEB_SEARCH_PROVIDER=auto
# TAVILY_API_KEY=tvly-...
# Tavily has a free tier of 1,000 searches a month and fetches each result's
# page text in the same request. One of the two options here is mandatory:
# it must be RAG_TAVILY_API_KEY or TAVILY_API_KEY.
# RAG_TAVILY_API_BASE_URL=https://api.tavily.com
# basic | advanced | fast | ultra-fast. Deeper search costs more credits.
# RAG_WEB_SEARCH_DEPTH=basic
# RAG_WEB_SEARCH_MAX_RESULTS=5
# Only the keyless backend fetches separately, so this applies to it alone.
# RAG_WEB_FETCH_PAGES=3
# RAG_WEB_TIMEOUT_SECONDS=15.0
# RAG_WEB_MAX_PAGE_CHARS=6000
# RAG_WEB_PAGE_MAX_BYTES=2000000

# --- batching (tuned for CPU; raise substantially on GPU) -------------------
# RAG_RERANK_BATCH_SIZE=16
# Chunks written to the store per upsert during ingest. This is the trade
# between query latency during an ingest and how finely progress is reported:
# a question asked mid-ingest waits for at most one slice, and the store guard
# is released between them. 64 chunks is roughly 2-4s of embedding on CPU.
# RAG_INGEST_SLICE_SIZE=64

# --- optional generation ---------------------------------------------------
# Off by default: the query graph returns ranked, cited context on its own.
# Everything except this stage is local and free.
# RAG_ENABLE_GENERATION=true
#
# Provider under "auto": OpenAI if OPENAI_API_KEY is set, else Groq (free
# tier), else generation stays off.
# RAG_LLM_PROVIDER=auto
#
# OPENAI_API_KEY=sk-...
# RAG_OPENAI_MODEL=gpt-4o-mini
#
# GROQ_API_KEY=gsk-...
# RAG_GROQ_MODEL=groq/openai/gpt-oss-120b
# LiteLLM model strings (groq/ prefix required); tried in order when the
# primary is rate limited. Defaults are Groq's free-tier models as of
# 2026-09-17 -- Groq retires models on a rolling schedule, so check
# https://console.groq.com/docs/deprecations if generation starts failing.
# RAG_GROQ_FALLBACK_MODELS=["groq/openai/gpt-oss-20b","groq/qwen/qwen3.6-27b"]
#
# Sampling and request bounds, applied to every model in the fallback chain.
# RAG_LLM_TEMPERATURE=0.0
# RAG_LLM_MAX_TOKENS=1024
# RAG_LLM_MAX_RETRIES=2
# RAG_LLM_TIMEOUT_SECONDS=60.0

# --- logging ---------------------------------------------------------------
# RAG_LOG_LEVEL=INFO
